<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Verwaltung – Handy Chirurg Potsdam</title>
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link href="/admin/config.yml" type="text/yaml" rel="cms-config-url">
</head>
<body>
  <!-- Decap CMS is served from this site, not from a CDN. -->
  <script>window.CMS_MANUAL_INIT = true;</script>
  <script src="/admin/cms-{{ decapVersion }}/decap-cms.js"></script>
  <script>
    // On the hosted site: password login (Netlify function admin-login), see netlify/functions/admin-login.mjs.
    // On localhost the local backend (npm run cms) is used as before.
    var local = /^(localhost|127\.0\.0\.1)$/.test(location.hostname);
    CMS.init(local ? {} : { config: { backend: { name: 'github', base_url: location.origin, auth_endpoint: '.netlify/functions/admin-login' } } });
  </script>
</body>
</html>
