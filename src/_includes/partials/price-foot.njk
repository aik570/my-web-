<div class="pricelist__foot">
  <p>Fehleranalyse ab <strong>{{ site.diagnosisFee.amount | euro }}</strong>, wird bei einer Reparatur verrechnet.</p>
  {%- if pricesMeta.vatNote %}<p>{{ pricesMeta.vatNote }}</p>{% endif %}
