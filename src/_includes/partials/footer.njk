<footer class="foot">
  <div class="wrap foot__grid">
    <div class="foot__brand">
      <img src="/assets/img/logo.svg" alt="{{ site.name }} – {{ site.tagline }}" width="756" height="366" loading="lazy">
    </div>
    <div>
      <h2 class="foot__h">Kontakt</h2>
      <p>{{ site.name }}<br>{{ site.street }}, {{ site.postcode }} {{ site.city }}<br>
        <a href="tel:{{ site.phone.dial }}">{{ site.phone.display }}</a><br>
        {%- if site.whatsapp %}<a href="https://wa.me/{{ site.whatsapp | replace('+', '') }}" target="_blank" rel="noopener">WhatsApp</a><br>{% endif %}
        <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
    <div>
      <h2 class="foot__h">Sprechzeiten</h2>
      <p>{% include "partials/hours-text.njk" %}</p>
      {%- if prices.brands.length %}
      <h2 class="foot__h">Preise nach Hersteller</h2>
      <p class="foot__brands">{% for b in prices.brands %}<a href="/preise/{{ b.slug }}/">{{ b.brand }}</a>{% endfor %}</p>
      {%- endif %}
    </div>
    <div>
      <h2 class="foot__h">Seiten</h2>
      <p><a href="/reparatur-finden/">Preisrechner</a><br><a href="/leistungen/">Reparaturleistungen</a><br><a href="/preise/">Preise</a><br><a href="/#ablauf">Ablauf</a><br><a href="/#kontakt">Kontakt</a><br><a href="/franchise/">Franchise</a></p>
      <h2 class="foot__h">Rechtliches</h2>
      <p><a href="/impressum/">Impressum</a><br><a href="/datenschutz/">Datenschutz</a></p>
    </div>
  </div>
</footer>
