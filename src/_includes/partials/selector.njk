{#- Price selector: Hersteller → Modell → Reparatur → Preis. Data is embedded at build time from the CMS price files. -#}
<div class="selector" data-selector>
  <script type="application/json" id="price-data">{{ { brands: prices.brands, types: prices.types, meta: pricesMeta, phone: site.phone, email: site.email, whatsapp: site.whatsapp } | json | safe }}</script>

  {%- if pricesMeta.status != 'verified' %}
  <p class="selector__demo" role="note"><strong>Testdaten.</strong> Die offizielle Preisliste wird gerade eingepflegt. Bis dahin nennen wir Ihnen den Preis gern am Telefon.</p>
  {%- endif %}

  {%- if prices.brands.length %}
  <div class="selector__controls">
    <div class="field">
      <label for="sel-brand"><span class="field__no">1</span>Hersteller</label>
      <select id="sel-brand">
        <option value="">Bitte wählen</option>
        {%- for b in prices.brands %}<option value="{{ b.brand }}">{{ b.brand }}</option>{% endfor %}
      </select>
    </div>
    <div class="field">
      <label for="sel-model"><span class="field__no">2</span>Modell</label>
      <select id="sel-model" disabled>
        <option value="">Erst Hersteller wählen</option>
      </select>
    </div>
    <div class="field field--search">
      <label for="sel-search">oder direkt suchen</label>
      <input id="sel-search" type="search" list="sel-models" placeholder="z. B. {{ prices.brands[0].models[0].name }}" autocomplete="off" inputmode="search">
      <datalist id="sel-models">
        {%- for b in prices.brands %}{% for m in b.models %}<option value="{{ b.brand }} {{ m.name }}"></option>{% endfor %}{% endfor %}
      </datalist>
    </div>
  </div>

  <div class="selector__result" id="sel-result" aria-live="polite">
    <p class="selector__empty"><span class="field__no">3</span>Wählen Sie Hersteller und Modell. Dann sehen Sie alle Reparaturen mit Preis.</p>
  </div>
  {%- else %}
  <div class="selector__result">
    <p class="selector__empty">Die Preisliste wird gerade aktualisiert. Rufen Sie uns an, wir nennen Ihnen den Preis sofort: <a href="tel:{{ site.phone.dial }}">{{ site.phone.display }}</a>.</p>
  </div>
  {%- endif %}

  <noscript><p class="selector__empty">Alle Preise finden Sie auch in der <a href="/preise/">kompletten Preisliste</a>.</p></noscript>
</div>
