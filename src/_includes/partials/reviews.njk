{#- Slim Google reviews strip above the footer. Only real data from reviews.json (filled from Google);
    without data: just the link to the reviews on Google. Nothing is invented. -#}
{%- set rv = reviewData %}
{%- set rvUrl = rv.googleUrl or site.mapsUrl %}
{%- macro stars(n) -%}
<span class="stars" role="img" aria-label="{{ n | string | replace('.', ',') }} von 5 Sternen">
  {%- for i in range(1, 6) %}<svg viewBox="0 0 20 20" aria-hidden="true" class="{{ 'is-on' if n >= i else ('is-half' if n >= i - 0.5 else '') }}"><path d="m10 1.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z"/></svg>{% endfor -%}
</span>
{%- endmacro %}
<aside class="rstrip" id="bewertungen" aria-label="Google-Bewertungen">
  <svg width="0" height="0" class="sr" aria-hidden="true"><defs><linearGradient id="star-half"><stop offset=".5" stop-color="#f2b01e"/><stop offset=".5" stop-color="#cfe6df"/></linearGradient></defs></svg>
  <div class="wrap rstrip__in">
    <p class="rstrip__label"><span class="rstrip__g" aria-hidden="true">G</span>Google-Bewertungen
      {%- if rv.items.length and rv.rating %} <b class="rstrip__score">{{ rv.rating | string | replace('.', ',') }}</b>{{ stars(rv.rating) }}{% if rv.count %}<small>({{ rv.count }})</small>{% endif %}{% endif %}
      {%- if rv.isSample %} <small class="rstrip__sample">Layouttest – keine echten Bewertungen</small>{% endif %}
    </p>
    {%- if rv.items.length %}
    <div class="rstrip__ticker" style="--rv-dur: {{ rv.items.length * 9 }}s">
      {%- for copy in [0, 1] %}
      <ul class="rstrip__track"{% if copy %} aria-hidden="true" inert{% endif %}>
        {%- for r in rv.items %}<li>{{ stars(r.rating) }}<q>{{ r.text | truncate(110) }}</q><span>– {{ r.author }}</span></li>{% endfor %}
      </ul>
      {%- endfor %}
    </div>
    {%- endif %}
    <a class="rstrip__link" href="{{ rvUrl }}" target="_blank" rel="noopener">Alle Bewertungen auf Google<span class="sr"> (öffnet Google Maps)</span> →</a>
  </div>
</aside>
