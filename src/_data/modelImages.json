  "rules": [
    {
      "brand": "apple",
      "pattern": "^iPhone 17( Pro( Max)?)?$",
      "image": "/assets/img/modelle/iphone-17.webp",
      "label": "Symbolbild iPhone 17-Serie",
      "exact": false
    },
    {
      "brand": "apple",
      "pattern": "^iPhone 16",
      "image": "/assets/img/modelle/iphone-16.webp",
      "label": "Symbolbild iPhone 16-Serie",
      "exact": false
    },
    {
      "brand": "apple",
