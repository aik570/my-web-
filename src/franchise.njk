---
permalink: /franchise/
eleventyComputed:
  seo:
    title: "{{ franchise.seo.title }}"
    description: "{{ franchise.seo.description }}"
---
{% extends "base.njk" %}

{% block main %}
<section class="sec sec--deep page-hero">
  <div class="wrap">
    <p class="kicker kicker--light"><span class="kicker__cross" aria-hidden="true"></span>{{ franchise.kicker }}</p>
    <h1 class="page-title page-title--light">{{ franchise.title }}</h1>
    <p class="head__lede head__lede--light">{{ franchise.lede }}</p>
    <div class="actions">
      {%- if franchise.contactEmail %}
      <a class="btn btn--signal" href="mailto:{{ franchise.contactEmail }}?subject={{ ('Franchise – ' ~ franchise.ctaLabel) | urlencode }}">{{ franchise.ctaLabel }}</a>
      {%- else %}
      <a class="btn btn--signal" href="tel:{{ site.phone.dial }}">{{ franchise.ctaLabel }}: {{ site.phone.display }}</a>
      {%- endif %}
    </div>
  </div>
  <canvas class="ecg ecg--wide" data-ecg data-ecg-wide height="90" aria-hidden="true"></canvas>
</section>

<section class="sec sec--mint franchise">
  <div class="wrap franchise__grid">
    <div>
      <h2 class="h2">Das Konzept.</h2>
      <p class="head__lede">{{ franchise.concept }}</p>
      <ul class="fhigh">
        {%- for x in franchise.highlights %}<li><strong>{{ x.title }}</strong><span>{{ x.text }}</span></li>{% endfor %}
      </ul>
    </div>
    {% include "partials/franchise-cards.njk" %}
  </div>
</section>

<section class="sec sec--white" aria-labelledby="stores-h">
  <div class="wrap">
    <h2 class="fstores__h" id="stores-h">{{ franchise.storesTitle }}</h2>
    <div class="svc-visit__photos fstores">
      <picture><source srcset="/assets/img/laden-empfang.webp" type="image/webp"><img src="/assets/img/laden-empfang.jpg" alt="Empfangsbereich im Laden von Handy Chirurg in Potsdam" width="1000" height="563" loading="lazy" decoding="async"></picture>
      <picture><source srcset="/assets/img/laden-theke.webp" type="image/webp"><img src="/assets/img/laden-theke.jpg" alt="Theke mit Zubehör im Laden von Handy Chirurg in Potsdam" width="1000" height="563" loading="lazy" decoding="async"></picture>
    </div>
  </div>
</section>

<section class="sec sec--white">
  <div class="wrap narrow center">
    <h2 class="h2">{{ franchise.interestTitle }}</h2>
    <p class="head__lede center">{{ franchise.interestText }}</p>
    <div class="actions actions--center">
      {%- if franchise.contactEmail %}
      <a class="btn btn--primary" href="mailto:{{ franchise.contactEmail }}">{{ franchise.contactEmail }}</a>
      {%- endif %}
      <a class="btn btn--quiet" href="tel:{{ site.phone.dial }}">{{ site.phone.display }}</a>
    </div>
  </div>
</section>
{% endblock %}
