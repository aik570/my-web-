---
permalink: /404.html
noindex: true
eleventyComputed:
  seo:
    title: "{{ pages.fehlerseite.seo.title }}"
    description: "{{ pages.fehlerseite.seo.description }}"
eleventyExcludeFromCollections: true
---
{% extends "base.njk" %}

{% block main %}
<section class="sec sec--white notfound">
  <div class="wrap narrow center">
    <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ pages.fehlerseite.kicker }}</p>
    <h1 class="page-title">{{ pages.fehlerseite.title }}</h1>
    <p class="head__lede center">{{ pages.fehlerseite.lede }}</p>
    <div class="actions actions--center">
      <a class="btn btn--primary" href="/">Zur Startseite</a>
      <a class="btn btn--quiet" href="/preise/">Preise ansehen</a>
      <a class="btn btn--quiet" href="tel:{{ site.phone.dial }}">Anrufen</a>
    </div>
  </div>
</section>
{% endblock %}
