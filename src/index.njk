---
permalink: /
bodyClass: is-home
---
{% extends "base.njk" %}

{% block intro %}
<!-- Loading animation, first visit per session: the Potsdam skyline is drawn like a pen
     stroke, HANDY CHIRURG appears, a spark runs along the heartbeat, then the logo docks
     into the header. Click, key, wheel or touch skips it. -->
<div class="intro" id="intro" aria-hidden="true">
  <div class="intro__logo" id="introLogo">
    {% include "partials/intro-logo.svg" %}
  </div>
</div>
{% endblock %}

{% block main %}
  {%- set h = home -%}

  <!-- ============ STORY: Aufnahme → OP → Entlassen ============ -->
  <section class="story" id="story" aria-label="{{ h.hero.title }}">
    <div class="story__sticky">
      <div class="story__lamp" aria-hidden="true"></div>
      <canvas id="phoneCanvas" class="story__canvas" aria-hidden="true"></canvas>
      <img class="story__poster" src="/assets/img/phone-poster.webp" alt="" width="533" height="1072" aria-hidden="true" fetchpriority="low">

      <div class="scene scene--hero" id="top">
        <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ h.hero.kicker }}</p>
        <h1>{{ h.hero.title | nbsp }}</h1>
        <p class="scene__lede">{{ h.hero.lede }}</p>
        <div class="actions">
          <a class="btn btn--primary" href="tel:{{ site.phone.dial }}">{{ h.hero.ctaPrimary }}</a>
          <a class="btn btn--quiet" href="/reparatur-finden/">{{ h.hero.ctaPrice }}</a>
        </div>

        <div class="monitor" data-monitor>
          <div class="monitor__top">
            <span class="monitor__label">Sprechzeiten heute</span>
            <span class="monitor__hours" data-hours-today>{{ site.hours[0].from }}–{{ site.hours[0].to }}</span>
          </div>
          <p class="monitor__state" data-state>{% include "partials/hours-text.njk" %}</p>
          <canvas class="ecg" data-ecg height="56" aria-hidden="true"></canvas>
          <div class="monitor__bottom">
            <span>{{ site.street }}</span>
            <span>Ohne Termin</span>
          </div>
        </div>
      </div>

      <div class="scene scene--open" aria-hidden="true">
        <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ h.sceneOpen.kicker }}</p>
        <p class="scene__title">{{ h.sceneOpen.title | nbsp }}</p>
        <p class="scene__lede">{{ h.sceneOpen.lede }}</p>
      </div>

      <div class="scene scene--done">
        <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ h.sceneDone.kicker }}</p>
        <p class="scene__title">{{ h.sceneDone.title | nbsp }}</p>
        <p class="scene__lede">{{ h.sceneDone.lede }}</p>
        <div class="actions">
          <a class="btn btn--primary" href="/reparatur-finden/">{{ h.hero.ctaPrice }}</a>
          <a class="btn btn--quiet" href="tel:{{ site.phone.dial }}">{{ h.hero.ctaPrimary }}</a>
        </div>
      </div>

      <div class="tags" aria-hidden="true">
        {%- for key in ['display', 'board', 'battery', 'frame', 'back'] %}
        <span class="tag" data-layer="{{ key }}"><b>{{ h.tags[key].title }}</b>{{ h.tags[key].text }}</span>
        {%- endfor %}
      </div>

      <p class="hint" aria-hidden="true">Scrollen, um den Eingriff zu sehen <span>· Ziehen zum Drehen</span></p>
    </div>
  </section>

  <!-- ============ PREISRECHNER ============ -->
  <section class="sec sec--mint" id="preisrechner" aria-labelledby="preisrechner-h">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ h.selector.kicker }}</p>
          <h2 id="preisrechner-h">{{ h.selector.title }}</h2>
          <p class="head__lede">{{ h.selector.lede }}</p>
        </div>
        
      </div>
      <div class="entry">
        <a class="entry__main" href="/reparatur-finden/">
          <span class="entry__steps"><span class="field__no">1</span> Gerät <span class="field__no">2</span> Reparatur <span class="field__no">3</span> Preis</span>
          <span class="entry__title">{{ h.selector.cta }}</span>
          <span class="entry__meta">{{ prices.models.length }} Modelle · {{ prices.rows }} Preise</span>
        </a>
        <ul class="entry__brands" aria-label="Direkt zum Hersteller">
          {%- for b in prices.brands %}<li><a href="/reparatur-finden/#{{ b.slug }}">{{ b.brand }}</a></li>{% endfor %}
          <li><a class="entry__all" href="/preise/">Komplette Preisliste</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ FACHBEREICHE ============ -->
  <section class="sec sec--white" id="leistungen" aria-labelledby="leistungen-h">
    <div class="wrap">
      <div class="head">
        <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ h.services.kicker }}</p>
        <h2 id="leistungen-h">{{ h.services.title }}</h2>
        <p class="head__lede">{{ h.services.lede }}</p>
      </div>

      <ul class="signs">
        {%- for s in services.items %}
        <li class="sign reveal">
          {% include "partials/pictogram.njk" %}
          <div class="sign__body">
            <h3>{{ s.title }}</h3>
            <p>{{ s.text }}</p>
          </div>
          <a class="sign__time" href="/preise/#{{ s.id }}">{{ s.duration }}<span class="sr"> – Preise für {{ s.title }}</span></a>
        </li>
        {%- endfor %}
      </ul>

      <div class="rx reveal">
        <div class="rx__head"><span>Befund</span><span>Fehleranalyse</span></div>
        <div class="rx__body">
          <p class="rx__price">{{ site.diagnosisFee.amount | euro }}</p>
          <p class="rx__text">{{ site.diagnosisFee.text }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ ZUSAGEN ============ -->
  <section class="sec sec--deep charter" aria-labelledby="charter-h">
    <div class="wrap charter__grid">
      <div class="charter__head">
        <p class="kicker kicker--light"><span class="kicker__cross" aria-hidden="true"></span>{{ h.charter.kicker }}</p>
        <h2 id="charter-h">{{ h.charter.title }}</h2>
      </div>
      <ol class="charter__list">
        {%- for c in h.charter.items %}
        <li class="reveal"><span class="charter__no">§ {{ loop.index }}</span><h3>{{ c.title }}</h3><p>{{ c.text }}</p></li>
        {%- endfor %}
      </ol>
    </div>
  </section>

  <!-- ============ BEHANDLUNGSWEG ============ -->
  <section class="sec sec--mint" id="ablauf" aria-labelledby="ablauf-h">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ h.process.kicker }}</p>
          <h2 id="ablauf-h">{{ h.process.title }}</h2>
        </div>
        <div class="switch" role="tablist" aria-label="Art der Abgabe">
          <button role="tab" id="tab-laden" aria-selected="true" aria-controls="panel-laden">{{ h.process.store.label }}</button>
          <button role="tab" id="tab-post" aria-selected="false" aria-controls="panel-post" tabindex="-1">{{ h.process.post.label }}</button>
        </div>
      </div>

      <div class="path">
        <svg class="path__line" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true">
          <path pathLength="1" d="M0 40 H130 M170 40 H430 M470 40 H600 L612 40 L622 10 L636 56 L646 28 L654 40 H730 M770 40 H1030 M1070 40 H1200" />
        </svg>
        {%- for track in [['laden', h.process.store, false], ['post', h.process.post, true]] %}
        <div role="tabpanel" id="panel-{{ track[0] }}" aria-labelledby="tab-{{ track[0] }}"{% if track[2] %} hidden{% endif %}>
          <ol class="steps">
            {%- for st in track[1].steps %}
            <li><span class="steps__station">{{ loop.index }}</span><h3>{{ st.title }}</h3><p>{{ st.text }}</p></li>
            {%- endfor %}
          </ol>
        </div>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- ============ SPRECHZEITEN & ANFAHRT ============ -->
  <section class="sec sec--white" id="laden" aria-labelledby="laden-h">
    <div class="wrap visit">
      <figure class="visit__photo reveal">
        <picture>
          <source srcset="/assets/img/laden-dortustrasse-800.webp 800w, /assets/img/laden-dortustrasse.webp 1200w" sizes="(max-width: 860px) 100vw, 50vw" type="image/webp">
          <img src="/assets/img/laden-dortustrasse-800.jpg" srcset="/assets/img/laden-dortustrasse-800.jpg 800w, /assets/img/laden-dortustrasse.jpg 1200w" sizes="(max-width: 860px) 100vw, 50vw" alt="{{ h.visit.photoAlt }}" width="1200" height="676" loading="lazy" decoding="async">
        </picture>
      </figure>

      <div class="board reveal">
        <div class="board__head">
          <img class="board__logo" src="/assets/img/logo-white.svg" alt="" width="756" height="366" loading="lazy">
          <div>
            <h2 id="laden-h">{{ h.visit.title }}</h2>
            <p>{{ site.name }} · {{ site.street }} · {{ site.postcode }} {{ site.city }}</p>
          </div>
        </div>
        <table class="hours" aria-label="Öffnungszeiten">
          <tbody>
            {%- for d in site.hours %}
            <tr data-day="{{ d.dayIndex }}"><th scope="row">{{ d.day }}</th><td>{% if d.open %}{{ d.from }} – {{ d.to }}{% else %}geschlossen{% endif %}</td></tr>
            {%- endfor %}
          </tbody>
        </table>
        <p class="board__note">{{ h.visit.note }}</p>
        <div class="actions">
          <a class="btn btn--white" href="{{ site.mapsUrl }}" target="_blank" rel="noopener">Route planen</a>
          <a class="btn btn--outline-light" href="tel:{{ site.phone.dial }}">Anrufen</a>
          {%- if site.whatsapp %}
          <a class="btn btn--outline-light" href="https://wa.me/{{ site.whatsapp | replace('+', '') }}" target="_blank" rel="noopener">WhatsApp</a>
          {%- endif %}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="sec sec--white faq" id="faq" aria-labelledby="faq-h">
    <div class="wrap faq__grid">
      <div>
        <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ h.faqIntro.kicker }}</p>
        <h2 id="faq-h">{{ h.faqIntro.title }}</h2>
        <p class="head__lede">Ihre Frage ist nicht dabei? Rufen Sie an: <a href="tel:{{ site.phone.dial }}">{{ site.phone.display }}</a>.</p>
      </div>
      <div class="faq__list">
        {%- for f in faq.items %}
        <details><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>
        {%- endfor %}
      </div>
    </div>
  </section>

  <!-- ============ CALL ============ -->
  <section class="sec sec--deep call" aria-labelledby="call-h">
    <div class="wrap">
      <p class="kicker kicker--light"><span class="kicker__cross" aria-hidden="true"></span>{{ h.call.kicker }}</p>
      <h2 id="call-h" class="call__title">{{ h.call.title }}</h2>
      <a class="call__number" href="tel:{{ site.phone.dial }}">{{ site.phone.display }}</a>
      <p class="call__meta">
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        {%- if site.whatsapp %}<a href="https://wa.me/{{ site.whatsapp | replace('+', '') }}" target="_blank" rel="noopener">WhatsApp</a>{% endif %}
        <span>{{ site.street }}, {{ site.city }}</span>
      </p>
    </div>
    <canvas class="ecg ecg--wide" data-ecg data-ecg-wide height="120" aria-hidden="true"></canvas>
  </section>

  <!-- ============ KONTAKT ============ -->
  <section class="sec sec--white contact" id="kontakt" aria-labelledby="kontakt-h">
    <div class="wrap contact__grid">
      <div class="contact__intro">
        <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ h.contact.kicker }}</p>
        <h2 id="kontakt-h">{{ h.contact.title }}</h2>
        <p class="head__lede">{{ h.contact.lede }}</p>
        <div class="contact__visit">
          <span class="nav__state contact__state" data-state-short><span class="nav__state-label">Sprechzeiten</span><span class="nav__state-time">{{ site.hours[0].from }}–{{ site.hours[0].to }}</span></span>
          <p><strong>{{ site.name }}</strong><br>{{ site.street }}, {{ site.postcode }} {{ site.city }}<br>Mo–Sa {{ site.hours[0].from }}–{{ site.hours[0].to }} Uhr · So geschlossen</p>
          <a class="link-arrow" href="{{ site.mapsUrl }}" target="_blank" rel="noopener">Route planen</a>
        </div>
        <div class="contact__doc" aria-hidden="true">
          {%- for d in [['besuch', 'mit Stadtplan'], ['anruf', 'am Telefon'], ['brief', 'beim Briefschreiben']] %}
          <picture class="contact__doc-{{ d[0] }}{% if loop.first %} is-on{% endif %}">
            <source srcset="/assets/img/doktor-{{ d[0] }}.webp 320w, /assets/img/doktor-{{ d[0] }}-640.webp 640w" sizes="(max-width: 860px) 150px, 230px" type="image/webp">
            <img src="/assets/img/doktor-{{ d[0] }}.png" alt="" width="320" height="430" loading="lazy" decoding="async">
          </picture>
          {%- endfor %}
        </div>
      </div>

      <div class="contact__box">
        <div class="ctabs" role="tablist" aria-label="Kontaktweg wählen">
          <button type="button" class="ctab" role="tab" id="ct-besuch" aria-controls="cp-besuch" aria-selected="true">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>Besuch</button>
          <button type="button" class="ctab" role="tab" id="ct-anruf" aria-controls="cp-anruf" aria-selected="false" tabindex="-1">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.9 3 5 3.8C4 4.1 3.4 5.2 3.6 6.2c1.7 7.2 7 12.6 14.2 14.2 1 .2 2.1-.4 2.4-1.4l.8-2.9-4.3-1.9-1.9 2c-2.6-1.2-4.8-3.4-6-6l2-1.9L9.1 4.2"/></svg>Anruf</button>
          {%- if site.whatsapp %}
          <button type="button" class="ctab" role="tab" id="ct-wa" aria-controls="cp-wa" aria-selected="false" tabindex="-1">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20l1.3-4A8 8 0 1 1 8 18.7z"/></svg>WhatsApp</button>
          {%- endif %}
          <button type="button" class="ctab" role="tab" id="ct-brief" aria-controls="cp-brief" aria-selected="false" tabindex="-1">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>Brief</button>
        </div>

        <div class="cpanel" role="tabpanel" id="cp-brief" aria-labelledby="ct-brief" hidden>
          <div class="envelope" aria-hidden="true"><div class="envelope__back"></div><div class="envelope__flap"></div><div class="envelope__front"></div></div>
          <form class="contact__form letter" id="contact-form" action="mailto:{{ site.email }}" method="post" enctype="text/plain" novalidate data-email="{{ site.email }}">
            <p class="letter__to"><span>An</span> {{ site.name }} · {{ site.email }}</p>
            <div class="field letter__field">
              <label for="cf-msg">Ihre Nachricht <span aria-hidden="true">*</span></label>
              <textarea id="cf-msg" name="nachricht" rows="5" required minlength="10" maxlength="2000" placeholder="Gerät, Modell und was nicht funktioniert" aria-describedby="cf-msg-hint"></textarea>
              <small class="letter__hint" id="cf-msg-hint" data-hint="msg">Mindestens 10 Zeichen</small>
            </div>
            <div class="letter__sign">
              <p class="letter__greet">Mit freundlichen Grüßen</p>
              <div class="field letter__field">
                <label for="cf-name">Name <span aria-hidden="true">*</span></label>
                <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="cf-name-hint">
                <small class="letter__hint" id="cf-name-hint" data-hint="name">Damit wir Sie ansprechen können</small>
              </div>
              <div class="field letter__field">
                <label for="cf-phone">Mobilnummer <small>(optional, für Rückruf)</small></label>
                <input id="cf-phone" name="telefon" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" pattern="[0-9 +\(\)\/\-]{6,40}" aria-describedby="cf-phone-hint">
                <small class="letter__hint" id="cf-phone-hint" data-hint="phone">Ziffern, Leerzeichen, + ( ) / -</small>
              </div>
            </div>
            <p class="contact__error" id="cf-error" role="alert" hidden></p>
            <div class="contact__send">
              <p class="letter__ready" id="cf-ready" aria-live="polite"></p>
              <button class="btn btn--primary" type="submit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 21 4l-7.5 18-2.3-7.7z"/><path d="m11.2 14.3 4.3-4.3"/></svg>Brief abschicken</button>
              <p class="selector__hint">{{ h.contact.note }} <a href="/datenschutz/">Datenschutz</a></p>
            </div>
          </form>
        </div>

        <div class="cpanel" role="tabpanel" id="cp-anruf" aria-labelledby="ct-anruf" hidden>
          <p class="cpanel__big"><a href="tel:{{ site.phone.dial }}">{{ site.phone.display }}</a></p>
          <p class="cpanel__text">Am schnellsten erreichen Sie uns telefonisch während der Sprechzeiten. Wir nennen Ihnen den Preis und ob das Teil vorrätig ist.</p>
          <span class="nav__state" data-state-short><span class="nav__state-label">Sprechzeiten</span><span class="nav__state-time">{{ site.hours[0].from }}–{{ site.hours[0].to }}</span></span>
          <div class="actions"><a class="btn btn--primary" href="tel:{{ site.phone.dial }}">Jetzt anrufen</a></div>
        </div>

        {%- if site.whatsapp %}
        <div class="cpanel" role="tabpanel" id="cp-wa" aria-labelledby="ct-wa" hidden>
          <p class="cpanel__text">Schicken Sie uns ein Foto vom Schaden – wir antworten mit einer Einschätzung.</p>
          <div class="actions"><a class="btn btn--primary" href="https://wa.me/{{ site.whatsapp | replace('+', '') }}" target="_blank" rel="noopener">WhatsApp öffnen</a></div>
        </div>
        {%- endif %}

        <div class="cpanel" role="tabpanel" id="cp-besuch" aria-labelledby="ct-besuch">
          <p class="cpanel__big">{{ site.street }}<br><span>{{ site.postcode }} {{ site.city }}</span></p>
          <span class="nav__state" data-state-short><span class="nav__state-label">Sprechzeiten</span><span class="nav__state-time">{{ site.hours[0].from }}–{{ site.hours[0].to }}</span></span>
          <p class="cpanel__text">Ohne Termin – kommen Sie einfach mit Ihrem Gerät vorbei. Mo–Sa {{ site.hours[0].from }}–{{ site.hours[0].to }} Uhr, sonntags geschlossen.</p>
          <div class="actions"><a class="btn btn--primary" href="{{ site.mapsUrl }}" target="_blank" rel="noopener">Route planen</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FRANCHISE TEASER ============ -->
  <section class="sec sec--mint franchise" aria-labelledby="franchise-h">
    <div class="wrap franchise__grid">
      <div>
        <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>{{ franchise.kicker }}</p>
        <h2 id="franchise-h">{{ franchise.title }}</h2>
        <p class="head__lede">{{ franchise.lede }}</p>
        <a class="btn btn--primary" href="/franchise/">Mehr zum Franchise</a>
      </div>
      {% include "partials/franchise-cards.njk" %}
    </div>
  </section>
{% endblock %}

{% block scripts %}
<script src="/assets/js/contact.js" defer></script>
{% endblock %}
