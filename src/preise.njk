---
permalink: /preise/
seo:
  title: Preise für Handyreparatur in Potsdam – Handy Chirurg
  description: Reparaturpreise für Smartphones, Tablets, Laptops und Smartwatches von Apple, Samsung, Huawei, Xiaomi, Google, Sony und OnePlus. Handy Chirurg, Dortustraße 23, Potsdam.
---
{% extends "base.njk" %}

{% block main %}
<section class="sec sec--white page-head">
  <div class="wrap">
    <p class="kicker"><span class="kicker__cross" aria-hidden="true"></span>Preisliste</p>
    <h1 class="page-title">Reparaturpreise</h1>
    <p class="head__lede">Wählen Sie den Hersteller oder suchen Sie direkt nach Ihrem Modell. Den endgültigen Preis bestätigen wir Ihnen vor jeder Reparatur.</p>
    {%- include "partials/price-notice.njk" %}
  </div>
</section>

<section class="sec sec--white pricelist" aria-label="Preisliste">
  <div class="wrap">
    {%- if prices.brands.length %}
    <script type="application/json" id="model-index">{{ prices.brands | modelIndex | json | safe }}</script>
    <div class="pricelist__tools pricelist__tools--single">
      <div class="field field--search">
        <label for="pl-find">Modell suchen</label>
        <input id="pl-find" type="search" placeholder="z. B. {{ prices.brands[0].models[0].name }}" autocomplete="off" aria-controls="pl-hits">
      </div>
    </div>
    <ul class="hits" id="pl-hits" aria-live="polite"></ul>
    <p class="pricelist__type" id="pl-type" hidden></p>

    <ul class="brandgrid">
      {%- for b in prices.brands %}
      <li><a class="brandcard" href="/preise/{{ b.slug }}/" data-brand-link>
        <span class="brandcard__name">{{ b.brand }}</span>
        <span class="brandcard__meta">{{ b.models.length }} Modelle · {{ b.models | categories | join(', ') }}</span>
      </a></li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p class="selector__empty">Die Preisliste wird gerade aktualisiert. Rufen Sie uns an: <a href="tel:{{ site.phone.dial }}">{{ site.phone.display }}</a>.</p>
    {%- endif %}

    {%- include "partials/price-foot.njk" %}
  </div>
</section>
{% endblock %}

{% block scripts %}
<script>
  // Model search across all brands; #akku etc. (from the homepage) carries the repair type to the brand pages.
  (function () {
    var idx = document.getElementById('model-index');
    if (!idx) return;
    var models = JSON.parse(idx.textContent);
    var input = document.getElementById('pl-find');
    var hits = document.getElementById('pl-hits');
    var typeNote = document.getElementById('pl-type');
    var types = {{ prices.types | json | safe }};
    var hash = '';
    var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); };
    function search() {
      var q = input.value.trim().toLowerCase();
      if (q.length < 2) { hits.innerHTML = ''; return; }
      var found = models.filter(function (m) { return (m[0] + ' ' + m[2]).toLowerCase().indexOf(q) >= 0; }).slice(0, 12);
      hits.innerHTML = found.length
        ? found.map(function (m) { return '<li><a href="' + '/preise/' + m[1] + '/#' + m[3] + '">' + esc(m[0] + ' ' + m[2]) + '</a></li>'; }).join('')
        : '<li class="hits__none">Kein Modell gefunden. Rufen Sie an, wir helfen Ihnen weiter: <a href="tel:{{ site.phone.dial }}">{{ site.phone.display }}</a>.</li>';
    }
    function fromHash() {
      var h = location.hash.slice(1);
      var t = types.filter(function (x) { return x.id === h; })[0];
      hash = t ? '#' + t.id : '';
      typeNote.hidden = !t;
      if (t) typeNote.textContent = 'Preise für ' + t.label + ': Wählen Sie den Hersteller.';
      [].forEach.call(document.querySelectorAll('[data-brand-link]'), function (a) { a.hash = hash; });
    }
    input.addEventListener('input', search);
    addEventListener('hashchange', fromHash);
    fromHash();
  })();
</script>
{% endblock %}
