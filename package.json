{
  "name": "handy-chirurg-potsdam",
  "version": "1.0.0",
  "private": true,
  "description": "Website of Handy Chirurg Potsdam: Eleventy static site with Decap CMS",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve --port 8080",
    "build": "eleventy",
    "cms": "decap-server",
    "import:prices": "node scripts/import-prices.mjs",
    "check": "node scripts/check-launch.mjs",
    "test": "node scripts/test-site.mjs && node scripts/test-production.mjs",
    "test:site": "node scripts/test-site.mjs",
    "test:prod": "node scripts/test-production.mjs",
    "preview": "eleventy && npx --yes http-server _site -p 8080 -c-1"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "decap-server": "^3.11.6"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "decap-cms": "^3.17.3",
    "markdown-it": "^15.0.3",
    "three": "^0.160.0"
  }
}
